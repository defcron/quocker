_quocker() {
    local cur prev command_index command
    local commands global_options command_options
    COMPREPLY=()
    cur=${COMP_WORDS[COMP_CWORD]}
    prev=${COMP_WORDS[COMP_CWORD-1]}
    commands='compose up start stop restart kill pause unpause down rm ps logs volume pull prune config port version kernel'
    global_options='-h --help -f --file -p --project-name --project-directory --env-file --profile'

    command_index=1
    while (( command_index < COMP_CWORD )); do
        case ${COMP_WORDS[command_index]} in
            -f|--file|-p|--project-name|--project-directory|--env-file|--profile)
                (( command_index += 2 ))
                ;;
            compose)
                (( command_index++ ))
                commands='up start stop restart kill pause unpause down rm ps logs volume pull prune config port version'
                ;;
            -*)
                (( command_index++ ))
                ;;
            *)
                break
                ;;
        esac
    done

    case $prev in
        -f|--file|-p|--project-name|--project-directory|--env-file|--profile)
            return
            ;;
    esac

    if (( COMP_CWORD <= command_index )); then
        COMPREPLY=( $(compgen -W "$commands $global_options" -- "$cur") )
        return
    fi

    command=${COMP_WORDS[command_index]}
    case $command in
        config)
            command_options='--format --environment --services --profiles --images --volumes --networks --quiet'
            if [[ $prev == --format ]]; then
                COMPREPLY=( $(compgen -W 'yaml json' -- "$cur") )
                return
            fi
            ;;
        up)
            command_options='--dry-run -d'
            ;;
        start|stop|restart|pause|unpause|down)
            command_options='--dry-run'
            ;;
        rm)
            command_options='--volumes -v -f'
            ;;
        logs)
            command_options='-f'
            ;;
        version)
            command_options='--short'
            ;;
        prune)
            command_options=''
            ;;
        kernel)
            if (( COMP_CWORD == command_index + 1 )); then
                COMPREPLY=( $(compgen -W 'select fetch update' -- "$cur") )
                return
            fi
            case ${COMP_WORDS[command_index+1]} in
                select|fetch)
                    command_options='--platform --rootfs --pubkey --module-release --json'
                    ;;
                update)
                    command_options='--url --catalog --pubkey'
                    ;;
            esac
            ;;
        kill)
            command_options='--dry-run -s --signal'
            if [[ $prev == -s || $prev == --signal ]]; then
                COMPREPLY=( $(compgen -W 'HUP INT QUIT KILL TERM USR1 USR2 SIGHUP SIGINT SIGQUIT SIGKILL SIGTERM SIGUSR1 SIGUSR2' -- "$cur") )
                return
            fi
            ;;
        port)
            command_options=''
            ;;
        volume)
            if (( COMP_CWORD == command_index + 1 )); then
                COMPREPLY=( $(compgen -W 'ls df inspect rm' -- "$cur") )
                return
            fi
            if [[ ${COMP_WORDS[command_index+1]} == rm ]]; then
                command_options='--dry-run'
            else
                command_options=''
            fi
            ;;
        *)
            command_options=''
            ;;
    esac

    if [[ $command == kernel ]]; then
        COMPREPLY=( $(compgen -W "$command_options" -- "$cur") )
    else
        COMPREPLY=( $(compgen -W "$global_options $command_options" -- "$cur") )
    fi
}

complete -F _quocker quocker
